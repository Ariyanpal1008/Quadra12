rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSyncCode(code) {
      return code is string && code.size() == 6 && code.matches('^[0-9]{6}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isCreatorAdmin() {
      return isSignedIn() && request.auth.token.email == 'ariyanpal090@gmail.com';
    }

    function isValidChangeRequest(data) {
      return data.keys().hasAll([
        'authorUid',
        'authorName',
        'category',
        'targetSection',
        'title',
        'details',
        'status',
        'creatorNote',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'authorUid',
        'authorName',
        'category',
        'targetSection',
        'title',
        'details',
        'status',
        'creatorNote',
        'createdAt',
        'updatedAt'
      ])
      && data.authorUid is string && isValidId(data.authorUid)
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
      && data.category in ['addition', 'change', 'syllabus_fix', 'bug_report']
      && data.targetSection in ['overview', 'subjects', 'exam', 'hackers', 'general']
      && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
      && data.details is string && data.details.size() >= 5 && data.details.size() <= 1500
      && data.status in ['new', 'planned', 'added']
      && data.creatorNote is string && data.creatorNote.size() <= 500
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSyncSession(data) {
      return data.keys().hasAll([
        'syncCode',
        'completedChapterIds',
        'chapterTasks',
        'watchedLectureIds',
        'bestScores',
        'dailyChapterLog',
        'customBoardDate',
        'theme',
        'soundMuted',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'syncCode',
        'completedChapterIds',
        'chapterTasks',
        'watchedLectureIds',
        'bestScores',
        'dailyChapterLog',
        'customBoardDate',
        'theme',
        'soundMuted',
        'createdAt',
        'updatedAt'
      ])
      && isValidSyncCode(data.syncCode)
      && data.completedChapterIds is list
      && data.completedChapterIds.size() <= 60
      && (data.completedChapterIds.size() == 0 || (data.completedChapterIds[0] is string && data.completedChapterIds[0].size() <= 32))
      && data.chapterTasks is map
      && data.chapterTasks.size() <= 60
      && data.watchedLectureIds is list
      && data.watchedLectureIds.size() <= 60
      && (data.watchedLectureIds.size() == 0 || (data.watchedLectureIds[0] is string && data.watchedLectureIds[0].size() <= 32))
      && data.bestScores is map
      && data.bestScores.size() <= 6
      && data.dailyChapterLog is map
      && data.dailyChapterLog.size() <= 400
      && data.customBoardDate is string && data.customBoardDate.size() <= 20
      && data.theme in ['light', 'dark']
      && data.soundMuted is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /changeRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        existing().authorUid == request.auth.uid || isCreatorAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid || isCreatorAdmin()
      );

      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidChangeRequest(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().status == 'new'
        && incoming().creatorNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(requestId)
        && isValidChangeRequest(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isCreatorAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'creatorNote', 'updatedAt'])
          )
          || (
            existing().authorUid == request.auth.uid
            && existing().status == 'new'
            && incoming().status == 'new'
            && incoming().creatorNote == existing().creatorNote
            && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'targetSection', 'title', 'details', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn() && isValidId(requestId) && (
        isCreatorAdmin()
        || (existing().authorUid == request.auth.uid && existing().status == 'new')
      );
    }

    match /syncSessions/{syncCode} {
      allow get: if isValidSyncCode(syncCode);
      allow list: if false;

      allow create: if isValidSyncCode(syncCode)
        && isValidSyncSession(incoming())
        && incoming().syncCode == syncCode
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidSyncCode(syncCode)
        && isValidSyncSession(incoming())
        && incoming().syncCode == existing().syncCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'completedChapterIds',
          'chapterTasks',
          'watchedLectureIds',
          'bestScores',
          'dailyChapterLog',
          'customBoardDate',
          'theme',
          'soundMuted',
          'updatedAt'
        ]);

      allow delete: if isCreatorAdmin() && isValidSyncCode(syncCode);
    }
  }
}
